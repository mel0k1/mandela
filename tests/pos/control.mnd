let mut i = 0
let mut hits = 0
while true:
    i = i + 1
    if i % 2 == 0:
        continue
    if i > 9:
        break
    hits = hits + i
print(hits)
print(7 % 3)
print(-7 / 2)
print(-7 % 2)
