#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOST="$ROOT/bootstrap/mandela.py"
CODEGEN="$ROOT/bootstrap/codegen.py"
ENTRY="$ROOT/src/main.mnd"

usage() {
    echo "Mandela v0.7"
    echo "usage: mandela <run|check|build|lex|ast> <file.mnd> [args...]"
    echo "       mandela build <file.mnd> [-o out] [--emit c|asm|bin]"
    echo "       mandela build --backend native <file.mnd> [-o out] [--arch x86-64|arm64]"
}

cmd="${1:-}"
if [ -z "$cmd" ]; then
    usage
    exit 1
fi
shift

case "$cmd" in
    check|lex|ast)
        f="${1:-}"
        if [ -z "$f" ]; then usage; exit 1; fi
        exec python3 "$HOST" "$ENTRY" -- "$cmd" "$f"
        ;;
    run)
        f="${1:-}"
        if [ -z "$f" ]; then usage; exit 1; fi
        shift
        python3 "$HOST" "$ENTRY" -- check "$f"
        exec python3 "$HOST" "$f" -- "$@"
        ;;
    build)
        f="${1:-}"
        if [ -z "$f" ]; then usage; exit 1; fi
        shift
        python3 "$HOST" "$ENTRY" -- check "$f"
        case " $* " in
            *" --backend native"*)
                nargs=()
                prev=""
                for a in "$@"; do
                    if [ "$prev" = "--backend" ]; then prev="$a"; continue; fi
                    [ "$a" = "--backend" ] && { prev="$a"; continue; }
                    nargs+=("$a")
                    prev="$a"
                done
                exec python3 "$ROOT/bootstrap/native.py" "$f" "${nargs[@]}" ;;
            *)
                exec python3 "$CODEGEN" "$f" "$@" ;;
        esac
        ;;
    *)
        usage
        exit 1
        ;;
esac
