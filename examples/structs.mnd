struct Point:
    x: int
    y: int

    def dot(self, other: Point) -> int:
        return self.x * other.x + self.y * other.y

    def move_by(mut self, dx: int, dy: int):
        self.x = self.x + dx
        self.y = self.y + dy

    def manhattan(self) -> int:
        if self.x < 0:
            return -self.x + self.y
        return self.x + self.y

struct Line:
    a: Point
    b: Point

    def dx(self) -> int:
        return self.b.x - self.a.x

def sum_points(ps: list[Point]) -> int:
    let mut total = 0
    for p in ps:
        total = total + p.x + p.y
    return total

def main():
    let mut a = Point { x: 1, y: 2 }
    let b = Point { x: 3, y: 4 }
    print(a.dot(b))
    a.move_by(10, 20)
    print(a.x)
    print(a.y)
    print(a.manhattan())
    let ps: list[Point] = [a, b]
    print(sum_points(ps))
    print(a)
    print(b == a)
    let l = Line { a: a, b: b }
    print(l.dx())

main()
